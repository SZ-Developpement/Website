# Formulaire de contact (app/actions/contact.ts). Copier en .env.local, ne
# jamais committer de vraie valeur ; sur Vercel : Settings > Environment Variables.

# Cle API Resend (obligatoire : sans elle, le formulaire affiche une erreur)
RESEND_API_KEY=

# Expediteur (optionnel). Doit appartenir a un domaine verifie chez Resend.
# Defaut : "SZ Dev <onboarding@resend.dev>"
CONTACT_FROM=

# Destinataire des demandes (optionnel). Defaut : l'e-mail de lib/data/site.ts
CONTACT_TO=
